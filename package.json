{
  "name": "shadtech",
  "version": "0.1.0",
  "private": true,
  "description": "SHADTECH — integrated technology platform for SMEs (monorepo)",
  "workspaces": [
    "backend",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:db": "npm run dev:db -w @shadtech/backend",
    "dev:api": "npm run start:dev -w @shadtech/backend",
    "dev:web": "npm run dev -w @shadtech/web",
    "db:generate": "npm run db:generate -w @shadtech/backend",
    "db:migrate": "npm run db:migrate -w @shadtech/backend",
    "db:deploy": "npm run db:deploy -w @shadtech/backend",
    "db:seed": "npm run db:seed -w @shadtech/backend",
    "db:studio": "npm run db:studio -w @shadtech/backend",
    "db:reset": "npm run db:reset -w @shadtech/backend",
    "build": "npm run build -w @shadtech/backend && npm run build -w @shadtech/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @shadtech/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:platform": "npm run dev -w platform",
    "db:platform:generate": "npm run db:generate -w platform",
    "db:platform:migrate": "npm run db:migrate -w platform",
    "db:platform:seed": "npm run db:seed -w platform"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@6.19.3": true
  }
}