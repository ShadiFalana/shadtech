# SHADTECH API — environment
# Copy to `.env` and adjust for your machine.

NODE_ENV=development
PORT=3001

# Allowed browser origin for the web app (CORS)
WEB_ORIGIN=http://localhost:5173

# Development database (matches `npm run dev:db`)
DATABASE_URL="postgresql://shadtech:shadtech@127.0.0.1:5432/shadtech?schema=public"

# Secret used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; development falls back to an insecure default.
JWT_SECRET=

# First administrator created by `npm run db:seed` (development only).
SEED_ADMIN_EMAIL=admin@shadtech.local
SEED_ADMIN_PASSWORD=ChangeMe123!
