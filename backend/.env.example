# SHADTECH API — environment
# Copy to `.env` and adjust for your machine.

NODE_ENV=development
PORT=3001

# Allowed browser origin for the web app (CORS)
WEB_ORIGIN=http://localhost:5173

# Development database (matches `npm run dev:db`)
DATABASE_URL="postgresql://shadtech:shadtech@127.0.0.1:5432/shadtech?schema=public"
